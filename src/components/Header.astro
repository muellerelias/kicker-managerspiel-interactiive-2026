---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  transparent?: boolean;
  back?: { href: string; label: string };
}

const { transparent = false, back } = Astro.props;
---

<header class={`site-header ${transparent ? "transparent" : ""}`}>
  <div class="container bar">
    {
      back ? (
        <a class="back" href={back.href}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18l-6-6 6-6" />
          </svg>
          {back.label}
        </a>
      ) : (
        <a class="brand" href="/">
          Bundesliga Vereine
        </a>
      )
    }
    <ThemeToggle overlay={transparent} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .site-header.transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    border-bottom: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
  }

  .back svg {
    flex-shrink: 0;
    display: block;
  }

  .transparent .back {
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .transparent .brand {
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }
</style>
