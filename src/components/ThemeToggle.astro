---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const options = [
  { value: "light", label: "Hell" },
  { value: "auto", label: "Automatisch" },
  { value: "dark", label: "Dunkel" },
] as const;
---

<div class={`theme-toggle ${overlay ? "overlay" : ""}`} role="group" aria-label="Farbschema wählen">
  {
    options.map((opt) => (
      <button type="button" data-theme-choice={opt.value} aria-label={opt.label} title={opt.label}>
        {opt.value === "light" && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        )}
        {opt.value === "auto" && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 18v3" />
          </svg>
        )}
        {opt.value === "dark" && (
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20.7 14.9A9 9 0 1 1 9.1 3.3a7 7 0 0 0 11.6 11.6Z" />
          </svg>
        )}
        <span class="sr-only">{opt.label}</span>
      </button>
    ))
  }
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-subtle);
  }

  .theme-toggle button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .theme-toggle button:hover {
    color: var(--text);
  }

  .theme-toggle button.active {
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .theme-toggle.overlay {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
  }

  .theme-toggle.overlay button {
    color: rgba(255, 255, 255, 0.85);
  }

  .theme-toggle.overlay button:hover {
    color: #fff;
  }

  .theme-toggle.overlay button.active {
    background: #fff;
    color: #14171c;
    box-shadow: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function initThemeToggle(root: ParentNode) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");

    function applyTheme(pref: string) {
      const resolved =
        pref === "auto"
          ? window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light"
          : pref;
      document.documentElement.setAttribute("data-theme", resolved);
      document.documentElement.setAttribute("data-theme-pref", pref);
      localStorage.setItem("theme", pref);
      buttons.forEach((b) => b.classList.toggle("active", b.dataset.themeChoice === pref));
    }

    buttons.forEach((b) => {
      b.addEventListener("click", () => applyTheme(b.dataset.themeChoice!));
    });

    const current = document.documentElement.getAttribute("data-theme-pref") || "auto";
    buttons.forEach((b) => b.classList.toggle("active", b.dataset.themeChoice === current));

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
      if ((localStorage.getItem("theme") || "auto") === "auto") applyTheme("auto");
    });
  }

  initThemeToggle(document);
</script>
